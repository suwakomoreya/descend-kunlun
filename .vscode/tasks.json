{
    "version": "2.0.0",
    "tasks": [
        {
        "label": "build",
        "type": "process",
        "command": "/usr/bin/clang++",
        "args": [
            "${workspaceFolder}/src/main.cpp",
            "${workspaceFolder}/src/collision.cpp",
            "-o", "${workspaceFolder}/game",
            "-std=c++20",
            "-Wall",
            "-I${workspaceFolder}",
            "-I${env:HOME}/.local/include",
            "-L${env:HOME}/.local/lib",
            "-lraylib",
            "-framework", "OpenGL",
            "-framework", "Cocoa",
            "-framework", "IOKit",
            "-framework", "CoreVideo"
        ],
        "problemMatcher": ["$gcc"]
        },
        {
        "label": "build and run",
        "type": "process",
        "command": "${workspaceFolder}/game",
        "options": { "cwd": "${workspaceFolder}" },
        "dependsOn": "build",
        "problemMatcher": [],
        "group": { "kind": "build", "isDefault": true }
        }
    ]
}
